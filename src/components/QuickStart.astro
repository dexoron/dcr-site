---
import { useTranslations, type Lang } from '../i18n';
import { docsHomePath } from '../docs/nav';
import Icon from './Icon.astro';
import Terminal from './Terminal.astro';
import InlineCodeText from './InlineCodeText.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const copy = t.quickStart;
---

<section
  class="quickstart"
  id="quick-start"
  aria-labelledby="quick-start-title"
>
  <div class="container">
    <div class="section-head">
      <h2 class="section-title" id="quick-start-title">{copy.title}</h2>
      <p class="section-lead"><InlineCodeText text={copy.lead} /></p>
    </div>

    <div class="quickstart__steps">
      {copy.steps.map((step) => (
        <div class="step">
          <div class="step__info">
            <div class="step__title-row">
              <span class="step__number" aria-hidden="true">{step.number}</span>
              <h3 class="step__title">{step.title}</h3>
            </div>
            <p class="step__text"><InlineCodeText text={step.description} /></p>
          </div>
          <div class="step__code">
            <Terminal title={step.terminal.title} lines={step.terminal.lines} />
          </div>
        </div>
      ))}
    </div>

    <div class="quickstart__cta">
      <p class="quickstart__question"><InlineCodeText text={copy.cta.question} /></p>
      <a
        class="button button--primary"
        href={docsHomePath()}
      >
        <span>{copy.cta.action}</span>
        <span class="icon-frame" aria-hidden="true">
          <Icon name="arrowRight" size={16} />
        </span>
      </a>
    </div>
  </div>

  <div class="section-rule" aria-hidden="true"></div>
</section>
