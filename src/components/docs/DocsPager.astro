---
import { docsHref, type DocsItem } from '../../docs/nav';
import Icon from '../Icon.astro';

interface Props {
  prev?: DocsItem | null;
  next?: DocsItem | null;
  locale?: string;
}

const { prev, next, locale = 'en' } = Astro.props;
---

{prev || next ? (
    <nav
      class="docs-pager"
      aria-label={locale === 'ru-RU' ? 'Страницы документации' : 'Documentation pages'}
    >
    {prev ? (
      <a
        class="docs-pager__link docs-pager__link--prev"
        href={docsHref(prev.slug, locale)}
        rel="prev"
      >
        <Icon
          name="chevronDown"
          size={16}
          class="docs-pager__caret docs-pager__caret--prev"
        />
        <span>{prev.label}</span>
      </a>
    ) : (
      <span aria-hidden="true"></span>
    )}
    {next ? (
      <a
        class="docs-pager__link docs-pager__link--next"
        href={docsHref(next.slug, locale)}
        rel="next"
      >
        <span>{next.label}</span>
        <Icon
          name="chevronDown"
          size={16}
          class="docs-pager__caret docs-pager__caret--next"
        />
      </a>
    ) : (
      <span aria-hidden="true"></span>
    )}
  </nav>
) : null}
