{
  "meta": {
    "title": "DCR — a build tool for C and C++, like Cargo",
    "description": "DCR builds C and C++ projects and manages their libraries. It works like Cargo. You need one file, dcr.toml, and a few easy commands: new, build, run, test."
  },
  "nav": {
    "home": "Home",
    "documentation": "Docs",
