    "donate": "Donate",
    "menu": "Menu"
  },
  "hero": {
    "titleLines": [
      "A build tool for C and C++",
      "that works like Cargo."
    ],
    "description": "Build, run, and test your C and C++ projects with one file called dcr.toml. DCR also takes care of your libraries. You do not need Makefiles or CMake scripts. Just use dcr new, dcr build, and dcr run.",
    "primaryAction": "Get started",
    "secondaryAction": "GitHub",
    "license": "GPLv3"
  },
