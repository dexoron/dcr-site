  "features": {
    "title": "Features",
    "lead": [
      "Everything you need to build C and C++.",
      "One tool, one config, one workflow."
    ],
    "items": [
      {
        "icon": "terminal",
        "title": "Simple commands",
        "description": "`new`, `build`, `run`, `test`, `clean`, `add`, `fmt`, `lint`: the whole workflow in one tool."
      },
      {
        "icon": "gitBranch",
        "title": "Path, Git, registry, and system dependencies",
        "description": "Use libraries from a local folder, a Git repository, a registry, or the system via `pkg-config`. `dcr.lock` records exactly what was resolved, including the Git commit."
      },
      {
        "icon": "globe",
        "title": "Cross-compilation",
        "description": "Build for another OS or architecture from the same project. Set the target with a full target triple or a short name like `windows`."
      },
      {
        "icon": "codeXml",
        "title": "Works with your IDE",
        "description": "`dcr gen` produces `compile_commands.json` and ready-made VS Code and CLion configs, so you can keep your editor."
      },
      {
        "icon": "fileCog",
        "title": "One project file",
        "description": "Name, language, standard, compiler, and dependencies all live in `dcr.toml`, not scattered across scripts."
      },
      {
        "icon": "bookOpen",
        "title": "Built-in help",
        "description": "Every command has `--help`, and package installs include man pages such as `man dcr-build`."
      }
    ]
  },
  "quickStart": {
    "title": "Quick Start",
    "lead": "Create and run a C or C++ project in three steps.",
    "steps": [
      {
        "number": "1",
        "title": "Create a project",
        "description": "`dcr new` sets up a project with a `dcr.toml` and a ready-to-build `src/main.c`.",
        "terminal": {
          "title": "Terminal",
          "lines": [
            {
              "segments": [
                {
                  "text": "$",
                  "tone": "prompt"
                },
                {
                  "text": " dcr new myapp"
                }
              ]
            },
            {
              "segments": [
                {
                  "text": "    "
                },
                {
                  "text": "Creating",
                  "tone": "green"
                },
                {
                  "text": " project `"
                },
                {
                  "text": "myapp",
                  "tone": "cyan"
                },
                {
                  "text": "`\n     "
                },
                {
                  "text": "Created",
                  "tone": "green"
                },
                {
                  "text": " project `"
                },
                {
                  "text": "myapp",
                  "tone": "green"
                },
                {
                  "text": "`\n"
                },
                {
                  "text": "info:",
                  "tone": "cyan"
                },
                {
                  "text": " Next steps:\n"
                },
                {
                  "text": "  cd myapp\n  dcr run",
                  "tone": "cyan"
                }
              ]
            },
            {
              "segments": [
                {
                  "text": "$",
                  "tone": "prompt"
                },
                {
                  "text": " cd myapp"
                }
              ]
            }
          ]
        }
      },
      {
        "number": "2",
        "title": "Configure",
        "description": "Describe the project in one short, readable TOML file. No CMake syntax required.",
        "terminal": {
          "title": "nvim dcr.toml",
          "lines": [
            {
              "segments": [
                {
                  "text": "[package]\n",
                  "tone": "amber"
                },
                {
                  "text": "name = "
                },
                {
                  "text": "\"myapp\"\n",
                  "tone": "green"
                },
                {
                  "text": "version = "
                },
                {
                  "text": "\"0.1.0\"\n",
                  "tone": "green"
                },
                {
                  "text": "dcr-version = "
                },
                {
                  "text": "\"0.9.6\"\n",
                  "tone": "green"
                },
                {
                  "text": "\n[build]\n",
                  "tone": "amber"
                },
                {
                  "text": "language = "
                },
                {
                  "text": "\"c\"\n",
                  "tone": "green"
                },
                {
                  "text": "standard = "
                },
                {
                  "text": "\"c11\"\n",
                  "tone": "green"
                },
                {
                  "text": "compiler = "
                },
                {
                  "text": "\"clang\"\n",
                  "tone": "green"
                },
                {
                  "text": "kind = "
                },
                {
                  "text": "\"bin\"\n",
                  "tone": "green"
                },
                {
                  "text": "\n[dependencies]",
                  "tone": "amber"
                }
              ]
            }
          ]
        }
      },
      {
        "number": "3",
        "title": "Build and run",
        "description": "`dcr run` builds the project and its dependencies, then runs the result.",
        "terminal": {
          "title": "Terminal",
          "lines": [
            {
              "segments": [
                {
                  "text": "$",
                  "tone": "prompt"
                },
                {
                  "text": " dcr run"
                }
              ]
            },
            {
              "segments": [
                {
                  "text": "     "
                },
                {
                  "text": "project",
                  "tone": "cyan"
                },
                {
                  "text": " myapp (debug, x86_64-unknown-linux-gnu)\n     "
                },
                {
                  "text": "compile",
                  "tone": "green"
                },
                {
                  "text": " myapp v0.1.0  [1/1]\n        "
                },
                {
                  "text": "done",
                  "tone": "green"
                },
                {
                  "text": " in 0.24s\n         "
                },
                {
                  "text": "run",
                  "tone": "green"
                },
                {
                  "text": " /home/user/myapp/target/x86_64-unknown-linux-gnu/debug/myapp\nHello World!"
                }
              ]
            }
          ]
        }
      }
