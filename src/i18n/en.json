  "download": {
    "title": "Download",
    "lead": "Install DCR with a single command.",
    "platforms": [
      {
        "id": "linux",
        "label": "Linux",
        "commands": [
          "curl -fsSL https://sh.dcr-tool.ru | sh"
        ]
      },
      {
        "id": "windows",
        "label": "Windows",
        "commands": [
          "irm https://ps1.dcr-tool.ru | iex"
        ]
      },
      {
        "id": "macos",
        "label": "macOS",
        "commands": [
          "curl -fsSL https://sh.dcr-tool.ru | sh"
        ]
      },
      {
        "id": "package-manager",
        "label": "Package Manager",
        "commands": [
          "yay -S dcr",
          "brew tap dexoron/dexoron && brew install dcr",
          "nix profile install github:dexoron/dcr",
          "cargo install dcr"
        ]
      }
    ],
    "then": "Then verify:",
    "verifyCommand": "dcr --version",
    "copy": "Copy",
