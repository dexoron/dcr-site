  "hero": {
    "titleLines": [
      "A Cargo-style build tool",
      "for C and C++."
    ],
    "description": "Build, run, and test C and C++ projects from a single dcr.toml, with dependencies managed for you. No Makefiles, no CMake scripts. Just dcr new, dcr build, and dcr run.",
    "primaryAction": "Get started",
    "secondaryAction": "GitHub",
    "license": "GPLv3"
  },
