  "features": {
    "title": "Features",
    "lead": [
      "Everything you need to build C/C++.",
      "One tool. One config. One workflow."
    ],
    "items": [
      {
        "icon": "terminal",
        "title": "Simple commands",
        "description": "`new`, `build`, `run`, `test`, `clean`, `add`, `fmt`: everything in one tool."
      },
      {
        "icon": "gitBranch",
        "title": "Dependencies from a path, Git or a registry",
        "description": "Add libraries from a local folder, a Git repository or a registry. A lock file keeps builds reproducible."
      },
      {
        "icon": "globe",
        "title": "Cross-compilation",
        "description": "Build for other platforms and architectures from a single project. Set the target by full target triple or a short name."
      },
      {
        "icon": "codeXml",
        "title": "Works with your IDE",
        "description": "Generate `compile_commands.json` or VS Code and CLion settings with `dcr gen`, and keep your editor."
      },
      {
        "icon": "fileCog",
        "title": "One project file",
        "description": "Name, language, standard, compiler and dependencies live in `dcr.toml` — nothing is scattered across scripts."
      },
      {
        "icon": "bookOpen",
        "title": "Built-in docs",
        "description": "Man pages for `dcr` and every command, e.g. `man dcr-build`. They work offline."
      }
    ]
  },
  "quickStart": {
    "title": "Quick Start",
    "lead": "Create and run a C/C++ project in three steps.",
    "steps": [
      {
        "number": "1",
        "title": "Create a project",
        "description": "Start with a C/C++ project that has a ready-made directory structure.",
        "terminal": {
          "title": "Terminal",
          "lines": [
            {
              "segments": [
                {
                  "text": "$",
                  "tone": "prompt"
                },
                {
                  "text": " dcr new myapp"
                }
              ]
            },
            {
              "segments": [
                {
                  "text": "Creating a Project `"
                },
                {
                  "text": "myapp",
                  "tone": "cyan"
                },
                {
                  "text": "`...\nProject `"
                },
                {
                  "text": "myapp",
                  "tone": "green"
                },
                {
                  "text": "` successfully created\n\n"
                },
                {
                  "text": "Next step:\n",
                  "tone": "green"
                },
                {
                  "text": "    cd myapp\n    dcr run",
                  "tone": "cyan"
                }
              ]
            },
            {
              "segments": [
                {
                  "text": "$",
                  "tone": "prompt"
                },
                {
                  "text": " cd myapp"
                }
              ]
            }
          ]
        }
      },
      {
        "number": "2",
        "title": "Configure",
        "description": "Describe the project in a short, readable file. No CMake syntax needed.",
        "terminal": {
          "title": "nvim dcr.toml",
          "lines": [
            {
              "segments": [
                {
                  "text": "[package]\n",
                  "tone": "amber"
                },
                {
                  "text": "name = "
                },
                {
                  "text": "\"myapp\"\n",
                  "tone": "green"
                },
                {
                  "text": "version = "
                },
                {
                  "text": "\"0.1.0\"\n",
                  "tone": "green"
                },
                {
                  "text": "dcr-version = "
                },
                {
                  "text": "\"0.9.1\"\n",
                  "tone": "green"
                },
                {
                  "text": "\n[build]\n",
                  "tone": "amber"
                },
                {
                  "text": "language = "
                },
                {
                  "text": "\"c\"\n",
                  "tone": "green"
                },
                {
                  "text": "standard = "
                },
                {
                  "text": "\"c11\"\n",
                  "tone": "green"
                },
                {
                  "text": "compiler = "
                },
                {
                  "text": "\"clang\"\n",
                  "tone": "green"
                },
                {
                  "text": "kind = "
                },
                {
                  "text": "\"bin\"\n",
                  "tone": "green"
                },
                {
                  "text": "\n[dependencies]",
                  "tone": "amber"
                }
              ]
            }
          ]
        }
      },
      {
        "number": "3",
        "title": "Build and run",
        "description": "One command compiles the project and its dependencies and runs the result.",
        "terminal": {
          "title": "Terminal",
          "lines": [
            {
              "segments": [
                {
                  "text": "$",
                  "tone": "prompt"
                },
                {
                  "text": " dcr run"
                }
              ]
            },
            {
              "segments": [
                {
                  "text": "  "
                },
                {
                  "text": "project",
                  "tone": "cyan"
                },
                {
                  "text": "   myapp  (debug)\n  "
                },
                {
                  "text": "compile",
                  "tone": "green"
                },
                {
                  "text": "   myapp v0.1.0  [1/1]\n  "
                },
                {
                  "text": "done",
                  "tone": "green"
                },
                {
                  "text": "      in 0.24s\n  "
                },
                {
                  "text": "run",
                  "tone": "green"
                },
                {
                  "text": "       target/debug/myapp\nHello World!"
                }
              ]
            }
          ]
