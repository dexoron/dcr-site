{
  "meta": {
    "title": "DCR — A Cargo-style build tool for C/C++",
    "description": "DCR is a Cargo-style build tool and dependency manager for C and C++. One dcr.toml, simple commands: new, build, run, test."
  },
  "nav": {
    "home": "Home",
    "documentation": "Documentation",
