    "menu": "Menu"
  },
  "hero": {
    "titleLines": [
      "A Cargo-style build tool",
      "for C and C++."
    ],
    "description": "DCR builds, runs and tests your C/C++ project from a single dcr.toml and manages its dependencies. No Makefiles, no CMake scripts — just dcr new, dcr build and dcr run.",
    "primaryAction": "Get started",
    "secondaryAction": "GitHub",
    "license": "GPLv3"
  },
