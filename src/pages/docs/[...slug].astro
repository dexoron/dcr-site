---
import { render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import DocsCode from '../../components/docs/DocsCode.astro';
import DocsTable from '../../components/docs/DocsTable.astro';
import Empty from '../../components/docs/Empty.astro';
import { loadDocsPages } from '../../docs/page-data';

export async function getStaticPaths() {
  const pages = await loadDocsPages();
  return pages
    .filter((page) => page.slug !== '')
    .map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props as { page: Awaited<ReturnType<typeof loadDocsPages>>[number] };
const { Content } = await render(page.entry);
---

<DocsLayout
  lang="en"
  title={page.label}
  groups={page.groups}
  current={page.slug}
  prev={page.prev}
  next={page.next}
>
  <Content components={{ h1: Empty, pre: DocsCode, table: DocsTable }} />
</DocsLayout>
